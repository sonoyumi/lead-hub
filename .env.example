# Скопируйте в .env и заполните. Сам .env в git не попадает.

# База: SQLite по умолчанию; PostgreSQL: postgresql+psycopg://user:password@localhost:5432/leads
DATABASE_URL=sqlite:///./data/leads.db

# Ключи для приёма заявок (по одному на сайт/форму, через запятую). Придумайте длинные случайные строки:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
INTAKE_KEYS=
# Ключ для управления (список заявок, статусы, менеджеры, статистика). Без него админ-API выключен.
ADMIN_KEY=

# Telegram (необязательно: без токена уведомления только пишутся в лог)
BOT_TOKEN=
# Куда слать эскалации и ежедневную сводку (ID руководителя или группы)
ADMIN_CHAT_ID=

TIMEZONE=Europe/Rome
# За сколько минут новую заявку должны взять в работу (потом — напоминание, после 2× — эскалация)
SLA_MINUTES=30
# Повторная заявка того же телефона/почты за это время склеивается с первой
DUPLICATE_WINDOW_HOURS=24
# Во сколько (по местному времени) присылать ежедневную сводку
DIGEST_HOUR=19

# Сайты, которым можно слать заявки прямо из браузера (JavaScript-форма), через запятую. Пусто = только с сервера.
CORS_ORIGINS=
